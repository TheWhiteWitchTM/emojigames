---
layout: null
permalink: /manifest.webmanifest
---
{
  "name": {{ site.title | jsonify }},
  "short_name": "Emoji Games",
  "description": {{ site.description | jsonify }},
  "id": {{ '/' | relative_url | jsonify }},
  "start_url": {{ '/' | relative_url | jsonify }},
  "scope": {{ '/' | relative_url | jsonify }},
  "display": "standalone",
  "orientation": "any",
  "background_color": "#000000",
  "theme_color": "#0a0a0a",
  "lang": "en",
  "categories": ["games", "entertainment"],
  "icons": [
    {
      "src": {{ '/assets/icons/icon-192.png' | relative_url | jsonify }},
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": {{ '/assets/icons/icon-512.png' | relative_url | jsonify }},
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": {{ '/assets/icons/icon-maskable-192.png' | relative_url | jsonify }},
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": {{ '/assets/icons/icon-maskable-512.png' | relative_url | jsonify }},
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Games",
      "url": {{ '/games/' | relative_url | jsonify }},
      "icons": [
        {
          "src": {{ '/assets/icons/icon-192.png' | relative_url | jsonify }},
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Releases",
      "url": {{ '/releases/' | relative_url | jsonify }},
      "icons": [
        {
          "src": {{ '/assets/icons/icon-192.png' | relative_url | jsonify }},
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": {{ '/assets/images/site.jpg' | relative_url | jsonify }},
      "sizes": "1168x784",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "Emoji Games"
    }
  ]
}
