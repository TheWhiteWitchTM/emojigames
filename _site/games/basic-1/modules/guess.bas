10 REM LESSON 3. IF AND RND.
20 CLS
30 COLOR 11, 0
40 PRINT "I PICKED 1 TO 100."
50 PRINT "YOU GUESS. I WILL HELP."
60 COLOR 7, 0
70 S = INT(RND(1) * 100) + 1
80 T = 0
90 LABEL AGAIN
100 T = T + 1
110 INPUT "GUESS"; G
120 IF G = S THEN GOTO YES
130 IF G < S THEN PRINT "HIGHER." : GOTO AGAIN
140 PRINT "LOWER."
150 GOTO AGAIN
160 LABEL YES
170 COLOR 10, 0
180 PRINT "YES. "; T; " TRIES."
190 PRINT "RND MADE THE SECRET."
200 END
