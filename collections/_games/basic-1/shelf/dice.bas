10 CLS
20 COLOR 11, 0
30 PRINT "THE BONES. 🎲"
40 COLOR 7, 0
50 INPUT "HOW MANY BONES"; N
60 IF N < 1 OR N > 12 THEN COLOR 9, 0 : PRINT "BETWEEN 1 AND 12." : COLOR 7, 0 : GOTO 50
70 F$ = "⚀⚁⚂⚃⚄⚅"
80 FOR I = 1 TO N
90 LET R = INT(RND(1) * 6) + 1
100 COLOR 15, 0
110 PRINT MID$(F$, R, 1); "  BONE"; I; ":"; R
120 NEXT I
130 COLOR 3, 0
140 PRINT "THAT IS ALL THE FATE YOU GET."
150 END
