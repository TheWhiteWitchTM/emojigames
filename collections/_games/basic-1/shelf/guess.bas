10 CLS
20 COLOR 11, 0
30 PRINT "A NUMBER. 1 TO 100."
40 COLOR 7, 0
50 LET S = INT(RND(1) * 100) + 1
60 LET T = 0
70 LABEL AGAIN
80 T = T + 1
90 INPUT "GUESS"; G
100 IF G = S THEN GOTO YES
110 IF G < S THEN COLOR 10, 0 : PRINT "HIGHER." : COLOR 7, 0 : GOTO AGAIN
120 COLOR 9, 0
130 PRINT "LOWER."
140 COLOR 7, 0
150 GOTO AGAIN
160 LABEL YES
170 COLOR 11, 0
180 PRINT "YES."; T; " TRIES."
190 END
