10 REM LESSON 9. SOUND AND DATA.
20 CLS
30 COLOR 14, 0
40 PRINT "A SCALE. C TO C."
50 COLOR 7, 0
60 DATA 262, "C", 294, "D", 330, "E"
70 DATA 349, "F", 392, "G", 440, "A"
80 DATA 494, "B", 523, "C"
90 FOR I = 1 TO 8
100 READ N, NOTE$
