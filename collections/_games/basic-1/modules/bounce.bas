10 REM LESSON 7. SPRITES BOUNCE.
20 CLS
30 AT 0, 0
40 PRINT "A STAR AND A BALL. ESC STOPS.";
50 A = SPRITE("⭐", 4, 6, 28)
60 B = SPRITE("⚽", 30, 16, 28)
70 SEND A, 8, 4
80 SEND B, -7, -3
90 WATCH TAP
100 LABEL LOOP
110 IF (COL(A) <= 1 AND VX(A) < 0) OR (COL(A) >= 36 AND VX(A) > 0) THEN SEND A, -VX(A), VY(A)
120 IF (ROW(A) <= 2 AND VY(A) < 0) OR (ROW(A) >= 21 AND VY(A) > 0) THEN SEND A, VX(A), -VY(A)
130 IF (COL(B) <= 1 AND VX(B) < 0) OR (COL(B) >= 36 AND VX(B) > 0) THEN SEND B, -VX(B), VY(B)
140 IF (ROW(B) <= 2 AND VY(B) < 0) OR (ROW(B) >= 21 AND VY(B) > 0) THEN SEND B, VX(B), -VY(B)
150 SLEEP 20
160 GOTO LOOP
170 LABEL TAP
180 SEND HIT, -VX(HIT), -VY(HIT)
190 SEND OTHER, -VX(OTHER), -VY(OTHER)
200 SOUND 520, 20
210 RETURN
