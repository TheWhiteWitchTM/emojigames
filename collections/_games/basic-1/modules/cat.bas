10 REM LESSON 10. A SPRITE WALKS.
20 CLS
30 COLOR 10, 0
40 AT 0, 0
50 PRINT "THE CAT WALKS. ESC STOPS.";
60 C = SPRITE("🐈", 2, 12, 40)
70 SEND C, 6, 0
80 LABEL WALK
90 IF COL(C) >= 34 AND VX(C) > 0 THEN SEND C, -6, 0 : SOUND 660, 40
100 IF COL(C) <= 2 AND VX(C) < 0 THEN SEND C, 6, 0 : SOUND 440, 40
110 SLEEP 40
120 GOTO WALK
