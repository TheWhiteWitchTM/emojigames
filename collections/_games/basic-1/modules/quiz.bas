10 REM LESSON 5. DATA AND READ.
20 CLS
30 COLOR 14, 0
40 PRINT "THREE SHORT QUESTIONS."
50 COLOR 7, 0
60 DATA "2 + 2", 4
70 DATA "LEGS ON A CAT", 4
80 DATA "DAYS IN A WEEK", 7
90 FOR Q = 1 TO 3
100 READ Q$, A
110 PRINT
120 PRINT Q; ". "; Q$
130 INPUT "ANSWER"; G
140 IF G = A THEN PRINT "YES." : GOTO ONWARD
150 PRINT "THE ANSWER IS "; A; "."
160 LABEL ONWARD
170 NEXT Q
180 PRINT
190 COLOR 10, 0
200 PRINT "DATA HELD THE ANSWERS."
210 END
