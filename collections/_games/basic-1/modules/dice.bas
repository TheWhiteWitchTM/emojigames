10 REM LESSON 4. A FAIR DIE.
20 CLS
30 COLOR 11, 0
40 PRINT "EACH FACE IS 1 IN 6."
50 COLOR 7, 0
60 INPUT "HOW MANY ROLLS"; N
70 IF N < 1 OR N > 12 THEN PRINT "USE 1 TO 12." : GOTO 60
80 F$ = "⚀⚁⚂⚃⚄⚅"
90 FOR I = 1 TO N
100 R = INT(RND(1) * 6) + 1
110 PRINT "ROLL "; I; "  "; MID$(F$, R, 1); "  "; R
120 NEXT I
130 COLOR 14, 0
140 PRINT "INT AND RND DID THAT."
150 END
