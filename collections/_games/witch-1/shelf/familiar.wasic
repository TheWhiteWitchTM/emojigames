10 SCRUB
20 COLOR 10, 0
30 AT 0, 0
40 CHANT "THE FAMILIAR. ESC SENDS HER HOME.";
50 CONJURE C = MINION("🐈", 2, 12, 40)
60 SEND C, 7, 0
70 MARK PACE
80 IF COL(C) >= 34 AND VX(C) > 0 THEN SEND C, -7, 0 : TONE 740, 40
90 IF COL(C) <= 2 AND VX(C) < 0 THEN SEND C, 7, 0 : TONE 520, 40
100 FREEZE 40
110 FLYTO PACE
